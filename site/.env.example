# Montreal: cobro, entrada por correo y registro en Google Sheet.
# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# El formulario de /montreal solo aparece cuando las 6 obligatorias (Stripe, Gmail, Sheet) están puestas
# y se vuelve a desplegar; mientras tanto se mantiene el botón de WhatsApp.

# Stripe → Developers → API keys (usa sk_test_... para pruebas y sk_live_... para cobrar de verdad)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://pedritoleal.com/api/montreal/webhook
# eventos: checkout.session.completed y checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Gmail del evento con verificación en dos pasos + contraseña de aplicación (16 letras)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcional: nombre que ve el comprador y a qué correo responden
MAIL_FROM_NAME=Venezuela se Levanta · Pedrito Leal
MAIL_REPLY_TO=

# Google Sheet: URL /exec de la aplicación web de Apps Script (site/integrations/google-sheet.gs) y su SECRET
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Opcional: cupo máximo de compras por función (cada compra = 2 personas). Vacío = sin límite.
MONTREAL_CAPACITY_7PM=
MONTREAL_CAPACITY_9PM=

# Opcional: dominio público para las URLs de regreso de Stripe
SITE_URL=https://pedritoleal.com
